# Database
DATABASE_URL=sqlite:///./data/qr_platform.db

# Lemon Squeezy
LEMON_SQUEEZY_API_KEY=your_api_key_here
LEMON_SQUEEZY_STORE_ID=your_store_id_here
LEMON_SQUEEZY_WEBHOOK_SECRET=your_webhook_secret_here

# Email (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
FROM_EMAIL=your_email@gmail.com
FROM_NAME=3D QR Platform

# Security
SECRET_KEY=your_jwt_secret_key_here_use_openssl_rand_hex_32
DOWNLOAD_TOKEN_EXPIRE_HOURS=72

# Clerk Authentication
# Get your JWKS URL from Clerk Dashboard -> API Keys
# Format: https://your-clerk-domain.clerk.accounts.dev/.well-known/jwks.json
CLERK_JWKS_URL=https://neutral-grizzly-76.clerk.accounts.dev/.well-known/jwks.json

# Admin User IDs (Clerk User IDs, comma-separated)
# User ID from JWT "sub" claim
ADMIN_USER_IDS=user_34QrYZsLdUnxaKYTBMGH5xLPFdi

# Admin emails (comma-separated) - Not used when email not in JWT
ADMIN_EMAILS=lsh678902@gmail.com

# Storage
STORAGE_PATH=./storage/orders
STATIC_PATH=./static

# CORS (프론트엔드 URL)
# 로컬 개발 + 로컬 네트워크 접근 허용
CORS_ORIGINS=http://localhost:5173,http://192.168.0.176:5173,https://your-frontend-domain.com

# Cloudflare Tunnel (선택사항)
PUBLIC_URL=https://your-tunnel-domain.com

